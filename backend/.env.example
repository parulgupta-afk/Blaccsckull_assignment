PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/feedants

# Auth (assignment assumes an existing auth service; this is a minimal stand-in)
JWT_SECRET=replace_with_a_long_random_secret

# How long a "pending payment" registration hold reserves a slot before
# it's released back into the pool (seconds)
REGISTRATION_HOLD_TTL_SECONDS=600

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
