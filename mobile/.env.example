# Expo automatically inlines any EXPO_PUBLIC_-prefixed variable from this
# file at build/start time -- no extra config needed (SDK 49+).
#
# --- Backend URL -----------------------------------------------------------
# - Backend + Expo Go running on the SAME machine, testing in a web browser
#   or the iOS simulator: localhost works.
# - Android emulator: use 10.0.2.2 instead of localhost.
# - Expo Go on a PHYSICAL phone: use your computer's LAN IP, e.g.
#   192.168.1.42 (find it with `ipconfig getifaddr en0` on Mac, or
#   `ipconfig` on Windows). Your phone and computer must be on the same
#   Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# --- Local dev/demo auth (NEVER a real user's token, NEVER production) ----
# 1. cd backend && npm run seed        (prints a demo user _id)
# 2. cd backend && npm run mint-token -- <that-user-id>
# 3. paste the printed JWT below
EXPO_PUBLIC_DEMO_AUTH_TOKEN=

# --- Local dev/demo competition -------------------------------------------
# The competition _id printed by `npm run seed` in the backend.
EXPO_PUBLIC_DEMO_COMPETITION_ID=
